      "destination": "/outstaffing-en.html",
      "permanent": true
    },
    {
      "source": "/outstaffinguz",
      "destination": "/outstaffing-uz.html",
      "permanent": true
    },
    {
      "source": "/staffly/ru",
      "destination": "/outstaffing.html",
      "permanent": true
    },
    {
      "source": "/kons",
      "destination": "/consulting.html",
      "permanent": true
    },
    {
      "source": "/eng",
      "destination": "/index-en.html",
      "permanent": true
    },
    {
      "source": "/poisk",
      "destination": "/vacancies.html",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "/resources.html",
      "permanent": false
    },
    {
      "source": "/ru",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/index-en.html",
      "permanent": true
    },
    {
      "source": "/uz",
      "destination": "/index-uz.html",
      "permanent": true
    },
    {
      "source": "/recruitment",
      "destination": "/recruitment.html",
      "permanent": true
    },
    {
      "source": "/recruitmenteng",
      "destination": "/recruitment-en.html",
      "permanent": true
    },
    {
      "source": "/recruitment/en",
      "destination": "/recruitment-en.html",
      "permanent": true
    },
    {
      "source": "/recruitmentuz",
      "destination": "/recruitment-uz.html",
      "permanent": true
    },
    {
      "source": "/recruitment/uz",
      "destination": "/recruitment-uz.html",
      "permanent": true
    },
    {
      "source": "/staffly",
      "destination": "/outstaffing.html",
      "permanent": true
    },
    {
      "source": "/staffly/en",
      "destination": "/outstaffing-en.html",
      "permanent": true
    },
    {
      "source": "/staffly/uz",
      "destination": "/outstaffing-uz.html",
      "permanent": true
    },
    {
      "source": "/consulting",
      "destination": "/consulting.html",
      "permanent": true
    },
    {
      "source": "/consultingeng",
      "destination": "/consulting-en.html",
      "permanent": true
    },
    {
      "source": "/consultinguz",
      "destination": "/consulting-uz.html",
      "permanent": true
    },
    {
      "source": "/vacancies",
      "destination": "/vacancies.html",
      "permanent": true
    },
    {
      "source": "/talent-pool",
      "destination": "/talent-pool.html",
      "permanent": true
    },
    {
      "source": "/analytics",
      "destination": "/analytics.html",
      "permanent": true
    },
    {
      "source": "/analytics/en",
      "destination": "/analytics-en.html",
      "permanent": true
    },
    {
      "source": "/analytics/uz",
      "destination": "/analytics-uz.html",
      "permanent": true
    },
    {
      "source": "/analytics/salaries",
      "destination": "/analytics-salaries.html",
      "permanent": true
    },
    {
      "source": "/analytics/salaries/en",
      "destination": "/analytics-salaries-en.html",
      "permanent": true
    },
    {
      "source": "/analytics/salaries/uz",
      "destination": "/analytics-salaries-uz.html",
      "permanent": true
    },
    {
      "source": "/insights",
      "destination": "/analytics-en.html",
      "permanent": true
    },
    {
      "source": "/resources",
      "destination": "/resources.html",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/articles/:slug",
      "destination": "/api/article?slug=:slug"
    },
    {
      "source": "/vacancies/:slug",
      "destination": "/api/vacancy?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "functions": {
    "api/article.js": {
      "includeFiles": "api/_shell*.html"
    },
    "api/vacancy.js": {
      "includeFiles": "api/_shell.html"
    }
  },
  "headers": [
    {
      "source": "/reports/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/anim/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
